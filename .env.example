# Twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_URL=https://your-domain.com/webhook/twilio

# App
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Whisper STT
WHISPER_MODEL=medium
WHISPER_CPU_THREADS=4

# Edge TTS (free Microsoft voices)
TTS_VOICE_EN=en-US-AvaNeural
TTS_VOICE_AR=ar-SA-ZariyahNeural

# Ollama LLM (local fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# LLM provider: "local" (Ollama) or "azure_openai" (Azure primary, local fallback)
LLM_PROVIDER=local
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAQ_MAX_DISTANCE=0.33
COMPANY_SIM_THRESHOLD=0.58
WEB_SEARCH_ENABLED=false

# Storage
FAQ_DATA_DIR=./data/faq
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=faq_embeddings

# FFmpeg (optional — path to the folder containing ffmpeg.exe, if not on PATH)
FFMPEG_PATH=
