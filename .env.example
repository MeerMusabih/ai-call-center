# Twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_URL=https://your-domain.com/webhook/twilio

# App
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Whisper STT
WHISPER_MODEL=base

# Edge TTS (free Microsoft voices)
TTS_VOICE_EN=en-US-AvaNeural
TTS_VOICE_AR=ar-SA-ZariyahNeural

# Ollama LLM
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage
FAQ_DATA_DIR=./data/faq
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=faq_embeddings

# FFmpeg (optional — path to the folder containing ffmpeg.exe, if not on PATH)
FFMPEG_PATH=
